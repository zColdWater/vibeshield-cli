{
  "name": "vibeshield-cli",
  "version": "7.0.0",
  "description": "Zero-dependency 6-phase deep security scanner CLI and GitHub Action for AI-built web apps (Next.js, Vite, Cursor, Lovable, Bolt, Supabase, Firebase) — TLS 443 + CNAME takeover, 24x2.5MB JS bundle unpacking, 52 secret patterns, 28 SPA-filtered Nuclei probes, Supabase 20-table RLS & Firebase RTDB/Firestore checks, Observatory CSP/HSTS parser & passive CVE matching.",
  "type": "module",
  "bin": {
    "vibeshield": "./bin/vibeshield.mjs"
  },
  "files": [
    "bin",
    "src",
    "action.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node ./bin/vibeshield.mjs",
    "test": "node ./bin/vibeshield.mjs --version && node --check ./src/scanner-engine.mjs && node --check ./bin/vibeshield.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "security",
    "supabase",
    "rls",
    "firebase-security",
    "secret-scanner",
    "nextjs",
    "cve-2025-29927",
    "cve-2025-48757",
    "csp",
    "tls",
    "appsec",
    "devsecops",
    "github-action",
    "vibe-coding",
    "cursor",
    "lovable",
    "cli"
  ],
  "homepage": "https://shipbastion.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/zColdWater/vibeshield-cli.git"
  },
  "bugs": {
    "url": "https://github.com/zColdWater/vibeshield-cli/issues"
  },
  "author": "OmniForge Studio",
  "license": "MIT"
}
